# Copy to config.env and edit, then `source config.env` before running the
# numbered deploy scripts.  config.env is git-ignored.

export AWS_REGION=us-east-1
export ACCOUNT_ID=123456789012                 # aws sts get-caller-identity --query Account --output text

export MONITOR_BUCKET=indot-bridge-pipeline     # your pipeline output bucket
export MONITOR_PREFIX=v1/

# Container image
export ECR_REPO=indot-bridge-monitor
export IMAGE_TAG=latest

# Lambda functions
export POLLER_FN=indot-bridge-poller
export ALERTER_FN=indot-bridge-alerter
export ROLE_NAME=indot-bridge-monitor-role

# Alerting (Amazon SES)
export MONITOR_ALERT_SENDER=alerts@example.org          # a VERIFIED SES identity (still needs setup)
export MONITOR_ALERT_RECIPIENTS=araujodsaa@gmail.com    # comma-separated

# Tuning (optional; defaults live in monitor_common/config.py)
export MONITOR_FIRE_RP_SCOUR=10
export MONITOR_FIRE_RP_OTHER=50
export MONITOR_STALE_WARN_HOURS=3      # email when a source falls this far behind
# export MONITOR_STATE_HOURS=48   # rolling buffer; precip window can't exceed this
export POLLER_MEMORY=3008
export POLLER_TIMEOUT=300
export ALERTER_MEMORY=2048
export ALERTER_TIMEOUT=300
export SCHEDULE_CRON="cron(55 * * * ? *)"           # :55 each hour (MRMS/NWM ~1 h latency)

# Daily summary (06_daily_schedule.sh). Sent EVERY day, quiet ones included, so
# that silence from the monitor is distinguishable from a dead monitor.
export MONITOR_DAILY_TZ=America/New_York
export MONITOR_DAILY_SEND_HOUR=6                # local hour, DST-aware via EventBridge Scheduler
export DAILY_SCHEDULE_NAME=indot-bridge-daily-summary
export DAILY_SCHEDULE_ROLE=indot-bridge-scheduler-role
